# Generated by b1 (bunnybotv1 agent) for BunnyOS
# 
# Usage / Setup Instructions:
# 1. Enable in host configuration:
#    services.zotero-webdav.enable = true;
#    services.zotero-webdav.domain = "zotero-sync.ts.net";
#    services.zotero-webdav.environmentFile = /var/lib/zotero-webdav/env; # optional out-of-store secrets file
# 2. Create secret file at /var/lib/zotero-webdav/env containing:
#    PASSWORD=your-secure-password
# 3. Rebuild NixOS:
#    sudo nixos-rebuild switch --flake .#<hostname>
{ config, pkgs, lib, ... }:

let
  cfg = config.services.zotero-webdav;
in
{
  options.services.zotero-webdav = {
    enable = lib.mkEnableOption "Zotero WebDAV sync server";
    port = lib.mkOption {
      type = lib.types.port;
      default = 8080;
      description = "Internal port for the WebDAV container.";
    };
    domain = lib.mkOption {
      type = lib.types.str;
      default = "zotero-sync.ts.net";
      description = "Tailscale / Caddy virtual host domain.";
    };
    environmentFile = lib.mkOption {
      type = lib.types.nullOr lib.types.path;
      default = null;
      description = "Path to an out-of-store environment file containing secrets (e.g. PASSWORD).";
    };
  };

  config = lib.mkMerge [
    (lib.mkIf cfg.enable {
      # Enable Podman for running OCI containers
      virtualisation.podman = {
        enable = true;
        dockerCompat = true;
        defaultNetwork.settings.dns_enabled = true;
      };

      # Persistent storage directory owned by unprivileged user (1000:1000)
      systemd.tmpfiles.rules = [
        "d /var/lib/zotero-webdav 0750 1000 1000 -"
      ];

      # WebDAV container running as unprivileged user 1000:1000
      virtualisation.oci-containers.backend = "podman";
      virtualisation.oci-containers.containers.zotero-webdav = {
        image = "hurlenko/webdav:v1.3.0";
        autoStart = true;
        ports = [
          "127.0.0.1:${toString cfg.port}:8080"
        ];
        environment = {
          UID = "1000";
          GID = "1000";
          USERNAME = "zotero";
          SCOPE = "/data";
          RO = "false";
          AUTH = "true";
        } // lib.optionalAttrs (cfg.environmentFile == null) {
          PASSWORD = "change-this-secure-password";
        };
        environmentFiles = lib.optional (cfg.environmentFile != null) cfg.environmentFile;
        volumes = [
          "/var/lib/zotero-webdav:/data"
        ];
      };

      # Caddy reverse proxy
      services.caddy = {
        enable = true;
        virtualHosts."${cfg.domain}" = {
          extraConfig = ''
            reverse_proxy 127.0.0.1:${toString cfg.port} {
              header_up Host {http.reverse_proxy.upstream.host}
              header_up X-Real-IP {http.reverse_proxy.upstream.remote_ip}
            }
          '';
        };
      };

      # Ensure firewall allows HTTP/HTTPS for proxy traffic
      networking.firewall.allowedTCPPorts = [ 80 443 ];
    })
    {
      assertions = [
        {
          assertion = cfg.enable -> (cfg.domain != "");
          message = "services.zotero-webdav.domain cannot be empty when zotero-webdav is enabled.";
        }
      ];
    }
  ];
}
